generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Bảng TaiKhoan (RDM 1.6.3.1)
model TaiKhoan {
  maTaiKhoan   Int            @id @default(autoincrement())
  tenDangNhap  String         @unique @db.VarChar(100)
  matKhau      String         @db.VarChar(255)
  hoTen        String         @db.VarChar(150)
  soDienThoai  String         @db.VarChar(20)
  email        String         @db.VarChar(150)
  trangThai    String         @default("Hoạt động") @db.VarChar(50)

  phanQuyens   PhanQuyen[]
  phieuNhaps   PhieuNhap[]
  phieuKiemKes PhieuKiemKe[]
  donHangs     DonHang[]
  hoaDons      HoaDon[]
}

// 2. Bảng VaiTro (RDM 1.6.3.2)
model VaiTro {
  maVaiTro   Int         @id @default(autoincrement())
  tenVaiTro  String      @unique @db.VarChar(50)

  phanQuyens PhanQuyen[]
}

// 3. Bảng PhanQuyen (RDM 1.6.3.3 - Khóa chính kép)
model PhanQuyen {
  maTaiKhoan Int
  maVaiTro   Int

  taiKhoan   TaiKhoan @relation(fields: [maTaiKhoan], references: [maTaiKhoan], onDelete: Cascade)
  vaiTro     VaiTro   @relation(fields: [maVaiTro], references: [maVaiTro], onDelete: Cascade)

  @@id([maTaiKhoan, maVaiTro])
}

// 4. Bảng DanhMuc (RDM 1.6.3.4)
model DanhMuc {
  maDanhMuc  Int     @id @default(autoincrement())
  tenDanhMuc String  @unique @db.VarChar(100)

  monAn      MonAn[]
}

// 5. Bảng MonAn (RDM 1.6.3.5)
model MonAn {
  maMonAn         Int              @id @default(autoincrement())
  tenMon          String           @db.VarChar(150)
  hinhAnh         String           @default("/images/default-food.jpg") @db.VarChar(255)
  moTa            String           @default("") @db.Text
  giaBan          Decimal          @db.Decimal(12, 2)
  trangThai       String           @default("Còn hàng") @db.VarChar(50)
  maDanhMuc       Int

  danhMuc         DanhMuc          @relation(fields: [maDanhMuc], references: [maDanhMuc])
  congThucs       CongThucMonAn[]
  chiTietDonHangs ChiTietDonHang[]
}

// 6. Bảng NguyenLieu (RDM 1.6.3.6)
model NguyenLieu {
  maNguyenLieu     Int                @id @default(autoincrement())
  tenNguyenLieu    String             @unique @db.VarChar(150)
  donViTinh        String             @db.VarChar(50)
  soLuongTonKho    Decimal            @default(0) @db.Decimal(12, 3)

  congThucs        CongThucMonAn[]
  chiTietPhieuNhaps ChiTietPhieuNhap[]
  chiTietKiemKes   ChiTietKiemKe[]
}

// 7. Bảng CongThucMonAn (RDM 1.6.3.7 - Khóa chính kép)
model CongThucMonAn {
  maMonAn       Int
  maNguyenLieu  Int
  soLuongCanTru Decimal    @db.Decimal(12, 3)

  monAn         MonAn      @relation(fields: [maMonAn], references: [maMonAn], onDelete: Cascade)
  nguyenLieu    NguyenLieu @relation(fields: [maNguyenLieu], references: [maNguyenLieu], onDelete: Cascade)

  @@id([maMonAn, maNguyenLieu])
}

// 8. Bảng NhaCungCap (RDM 1.6.3.8)
model NhaCungCap {
  maNhaCungCap  Int         @id @default(autoincrement())
  tenNhaCungCap String      @db.VarChar(150)
  soDienThoai   String      @db.VarChar(20)
  diaChi        String      @db.Text

  phieuNhaps    PhieuNhap[]
}

// 9. Bảng PhieuNhap (RDM 1.6.3.9)
model PhieuNhap {
  maPhieuNhap       Int                @id @default(autoincrement())
  maNhanVien        Int
  maNhaCungCap      Int
  ngayNhap          DateTime           @default(now())
  tongTien          Decimal            @db.Decimal(12, 2)

  nhanVien          TaiKhoan           @relation(fields: [maNhanVien], references: [maTaiKhoan])
  nhaCungCap        NhaCungCap         @relation(fields: [maNhaCungCap], references: [maNhaCungCap])
  chiTietPhieuNhaps ChiTietPhieuNhap[]
}

// 10. Bảng ChiTietPhieuNhap (RDM 1.6.3.10 - Khóa chính kép)
model ChiTietPhieuNhap {
  maPhieuNhap  Int
  maNguyenLieu Int
  soLuong      Decimal    @db.Decimal(12, 3)
  donGia       Decimal    @db.Decimal(12, 2)

  phieuNhap    PhieuNhap  @relation(fields: [maPhieuNhap], references: [maPhieuNhap], onDelete: Cascade)
  nguyenLieu   NguyenLieu @relation(fields: [maNguyenLieu], references: [maNguyenLieu])

  @@id([maPhieuNhap, maNguyenLieu])
}

// 11. Bảng PhieuKiemKe (RDM 1.6.3.11)
model PhieuKiemKe {
  maPhieuKiemKe  Int             @id @default(autoincrement())
  maNhanVien     Int
  ngayKiemKe     DateTime        @default(now())

  nhanVien       TaiKhoan        @relation(fields: [maNhanVien], references: [maTaiKhoan])
  chiTietKiemKes ChiTietKiemKe[]
}

// 12. Bảng ChiTietKiemKe (RDM 1.6.3.12 - Khóa chính kép)
model ChiTietKiemKe {
  maPhieuKiemKe   Int
  maNguyenLieu    Int
  soLuongLyThuyet Decimal     @db.Decimal(12, 3)
  soLuongThucTe   Decimal     @db.Decimal(12, 3)
  lyDoChenhLech   String      @db.Text

  phieuKiemKe     PhieuKiemKe @relation(fields: [maPhieuKiemKe], references: [maPhieuKiemKe], onDelete: Cascade)
  nguyenLieu      NguyenLieu  @relation(fields: [maNguyenLieu], references: [maNguyenLieu])

  @@id([maPhieuKiemKe, maNguyenLieu])
}

// 13. Bảng KhuyenMai (RDM 1.6.3.13)
model KhuyenMai {
  maKhuyenMai   Int      @id @default(autoincrement())
  codeKhuyenMai String   @unique @db.VarChar(50)
  mucGiam       Decimal  @db.Decimal(12, 2)
  ngayBatDau    DateTime
  ngayKetThuc   DateTime
  soLanDung     Int
  donToiThieu   Decimal  @db.Decimal(12, 2)
  trangThai     String   @default("Đang chạy") @db.VarChar(50)

  hoaDons       HoaDon[]
}

// 14. Bảng DonHang (RDM 1.6.3.14)
model DonHang {
  maDonHang       Int              @id @default(autoincrement())
  maKhachHang     Int?
  ngayDat         DateTime         @default(now())
  tongTien        Decimal          @db.Decimal(12, 2)
  hinhThuc        String           @db.VarChar(50)
  trangThai       String           @default("Chờ xử lý") @db.VarChar(50)
  ghiChu          String?          @db.Text

  khachHang       TaiKhoan?        @relation(fields: [maKhachHang], references: [maTaiKhoan])
  chiTietDonHangs ChiTietDonHang[]
  hoaDons         HoaDon[]
}

// 15. Bảng ChiTietDonHang (RDM 1.6.3.15 - Khóa chính kép)
model ChiTietDonHang {
  maDonHang    Int
  maMonAn      Int
  soLuong      Int
  donGia       Decimal @db.Decimal(12, 2)
  trangThaiMon String  @default("Chờ") @db.VarChar(50)
  ghiChu       String? @db.Text

  donHang      DonHang @relation(fields: [maDonHang], references: [maDonHang], onDelete: Cascade)
  monAn        MonAn   @relation(fields: [maMonAn], references: [maMonAn])

  @@id([maDonHang, maMonAn])
}

// 16. Bảng HoaDon (RDM 1.6.3.16)
model HoaDon {
  maHoaDon            Int        @id @default(autoincrement())
  maDonHang           Int
  maNhanVien          Int
  maKhuyenMai         Int?
  ngayThanhToan       DateTime   @default(now())
  tongTienCuoiCung    Decimal    @db.Decimal(12, 2)
  phuongThucThanhToan String     @db.VarChar(50)

  donHang             DonHang    @relation(fields: [maDonHang], references: [maDonHang])
  nhanVien            TaiKhoan   @relation(fields: [maNhanVien], references: [maTaiKhoan])
  khuyenMai           KhuyenMai? @relation(fields: [maKhuyenMai], references: [maKhuyenMai])
}